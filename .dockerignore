# Governs what COPY puts in the image. The heavy collector databases are named explicitly rather than excluding
# `data`, because excluding the directory silently left out data/record.db and the web service deployed with an
# empty archive.
node_modules
data/pump.db*
# data/seed.db is COPYed deliberately: mergeSeed reads it on boot to give a fresh collector the history it lacks.
# Excluding it here was the fourth independent reason seeding never worked, after an exporter that threw, a missing
# importer, and .railwayignore. .railwayignore governs what is uploaded; this file governs what COPY puts in the
# image, and fixing one without the other ships nothing.
data/archive.db*
data/reports
data/telegram.session
data/*.jsonl
site/t
site/w
site/api/t
site/api/w
.env
.env.bak.*
*.log
