# ---- Paper trading ----
BUY_SOL=0.1                 # SOL spent per paper buy
PRIO_FEE_SOL=0.001          # simulated priority fee per tx (buy and sell)
FILL_LATENCY_MS=1500        # delay between decision and simulated fill
WATCH_MINUTES=60            # how long to track each launch
DB_PATH=data/pump.db

# ---- Data source ----
# rpc (default): decode pump.fun program logs from a Solana websocket. Free on the public
#   endpoint; a private RPC (Helius/QuickNode/Triton) is more reliable under load.
# pumpportal: PumpPortal websocket. Launches are free, but per-token trade streams require
#   an API key funded with >= 0.02 SOL (create one at pumpportal.fun).
TRADE_SOURCE=rpc
SOLANA_WS_URL=wss://api.mainnet-beta.solana.com
PUMPPORTAL_API_KEY=

# ---- KOL Twitter watcher (optional; disabled if no provider configured) ----
# Provider: "x" (official X API v2 bearer token) or "twitterapi" (twitterapi.io)
TWITTER_PROVIDER=
X_BEARER_TOKEN=
TWITTERAPI_IO_KEY=
KOL_FILE=kols.txt
KOL_POLL_SECONDS=60         # how often each watched account is re-polled

# ---- Telegram channel watcher (reads channels with YOUR account via MTProto) ----
# 1) create an app at https://my.telegram.org -> "API development tools", copy api_id / api_hash
# 2) npm run telegram:login   (one-time; saves data/telegram.session)
# 3) put channel usernames in channels.txt
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_CHANNELS_FILE=channels.txt
WATCH_MAX_MINUTES=360        # keep following tokens that are still trading, up to this long

# ---- Optional Telegram alerts (bot -> your chat) ----
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---- HTTP RPC for curvepoll / history (comma separated, priority order) ----
# A free Helius key (https://dev.helius.xyz) makes the history rebuild ~10x faster; the poller prefers the free official endpoint.
SOLANA_RPC_URLS=https://mainnet.helius-rpc.com/?api-key=YOUR_KEY,https://solana-rpc.publicnode.com,https://api.mainnet-beta.solana.com
CURVEPOLL_RPC_URLS=https://api.mainnet-beta.solana.com,https://mainnet.helius-rpc.com/?api-key=YOUR_KEY
