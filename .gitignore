node_modules

# Databases are build products, not source. The collector's is 7 GB; the record is rebuilt by `npm run servicedb`.
data/*.db
data/*.db-*

# Secrets and session material.
.env
.env.bak.*
data/telegram.session

# Generated output and run artifacts.
site/
data/reports/
*.log

# Small derived data that IS worth versioning, because it is how claims are checked and reproduced:
!data/labels.json
!data/operator-clusters.json
!data/x-mute.json

# Caller lists. Local operating files, never published: they name identifiable X accounts and
# Telegram channels alongside our own unverified characterisations of what those people were
# doing ("caller network seen posting the CA at or just before launch"). Publishing an
# unverified adverse claim about a named person is the exact thing every published sentence on
# this site is written to avoid, and these belong to the trading thesis, which is dead.
kols.txt
channels.txt
channels.candidates.txt
data/x-mute.json

# macOS.
.DS_Store

